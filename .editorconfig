# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# GDScript usa tabulaciones según su guía de estilo oficial
[*.gd]
indent_style = tab
indent_size = 4

# Archivos que genera Godot: no se reformatean
[*.{tscn,tres,godot,import,cfg}]
trim_trailing_whitespace = false
insert_final_newline = false

# En Markdown, dos espacios al final de una línea son un salto de línea
[*.md]
trim_trailing_whitespace = false
