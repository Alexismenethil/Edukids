              "id": "a",
              "text": "Con cemento y fierro"
            },
            {
              "id": "b",
              "text": "Con piedras y champa",
              "correct": true
            },
            {
              "id": "c",
              "text": "Con madera de eucalipto"
            },
            {
              "id": "d",
              "text": "Con plástico"
            }
          ],
          "feedback": {
            "correct": "¡Correcto!",
            "incorrect": "Está en el primer párrafo."
          },
